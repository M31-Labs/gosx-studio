# Ignore patterns for gts / hypha analyze code-intelligence indexing.
#
# This is DISTINCT from .gitignore: gts merges .graftignore and .gtsignore
# (not .gitignore) when deciding what to walk. Without this file, gts index
# build / hypha analyze traverses generated build output and vendored JS
# dependencies and never completes in reasonable time.
#
# Keep this scoped to generated/vendored, non-first-party content only.

# Built frontend bundle (~234MB), fully regenerated by the build.
dist/
dist/**

# Vendored JS test-harness dependencies.
**/node_modules/
parity_e2e/node_modules/

# Code-generated Go stub package (`// Code generated by gosx. DO NOT EDIT.`).
modules/

# Playwright test-run artifacts.
parity_e2e/test-results/

# gts/hypha's own index caches — never index the index.
.gts/
.analyses/
