{
  "name": "@m31labs/gosx-studio-parity-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright parity test harness for the gosx-studio runtime burn-down (Phase 3). Shared across all 7 slices.",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:reference-apps": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_authoring_test.ts reference_apps_visual_a11y_test.ts reference_apps_performance_test.ts reference_apps_canvas_test.ts reference_apps_canvas_interaction_test.ts reference_apps_canvas_selection_test.ts reference_apps_canvas_authoring_test.ts reference_apps_canvas_default_test.ts reference_apps_canvas_marquee_nav_test.ts reference_apps_canvas_wasm_free_test.ts reference_apps_canvas_html_surface_test.ts reference_apps_canvas_inline_edit_test.ts",
    "test:reference-apps:canvas": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_test.ts",
    "test:reference-apps:canvas-wasm-free": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_wasm_free_test.ts",
    "test:reference-apps:canvas-html-surface": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_html_surface_test.ts",
    "test:reference-apps:canvas-inline-edit": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_inline_edit_test.ts",
    "test:reference-apps:canvas-selection": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_selection_test.ts",
    "test:reference-apps:canvas-authoring": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_authoring_test.ts",
    "test:reference-apps:canvas-default": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_default_test.ts",
    "test:reference-apps:canvas-marquee-nav": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_canvas_marquee_nav_test.ts",
    "test:reference-apps:visual-a11y": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_visual_a11y_test.ts",
    "test:reference-apps:performance": "GOSX_STUDIO_REFERENCE_APP_E2E=1 playwright test reference_apps_performance_test.ts",
    "smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
